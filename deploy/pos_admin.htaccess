# public_html/pos_admin/.htaccess
# Node on 127.0.0.1:8000 (pm2 start index.js --name pos_admin)
#
# IMPORTANT: Do NOT use RewriteRule [P] proxy here — it caused ~58s API latency on ded4240.
# Proxy /pos_admin in Apache vhost instead: deploy/apache-pos-admin-vhost.conf

RewriteEngine On
RewriteBase /pos_admin/

DirectoryIndex disabled
Options -Indexes

<FilesMatch "^(index\.js|\.env|package\.json|package-lock\.json)$">
  Require all denied
</FilesMatch>

RewriteRule ^logs/ - [F,L]

# Uploads: serve from disk (vhost Alias also handles /pos_admin/uploads when configured)
RewriteRule ^api/uploads/(.+)$ uploads/$1 [L]
RewriteRule ^uploads/ - [L]

# --- Proxy is in Apache vhost (deploy/apache-pos-admin-vhost.conf), NOT here ---
# If vhost is not configured yet, temporarily uncomment the next line (slow — fix vhost ASAP):
# RewriteRule ^(.*)$ http://127.0.0.1:8000/$1 [P,L,QSA]
