# local (default)
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017/test

# Dev monitoring (on by default; set MONITORING_ENABLED=false on production servers)
# MONITORING_ENABLED=true
# MONITORING_REQUIRE_AUTH=true
# MONITORING_KEY=change-me
# LOG_LEVEL=debug
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=1
# MONITOR_SLOW_MS=500
# MONITOR_VERY_SLOW_MS=1000
# MONITOR_CRITICAL_SLOW_MS=3000
# MONITOR_MONGO_SLOW_MS=500
# MONITOR_LAG_WARN_MS=50
# MONITOR_LAG_CRIT_MS=100
# MONITOR_ELU_WARN=0.7
# MONITOR_ELU_CRIT=0.9
# MONITOR_HEAP_WARN=0.7
# MONITOR_HEAP_CRIT=0.85
# MONITOR_ERROR_RATE_CRIT=5
# MONITOR_P95_WARN_MS=500
# MONITOR_ALERT_CONSECUTIVE=2

# Production URL — API base (include /api if your frontend calls /pos_admin/api/...)
# BASE_URL=https://testv3.websitedemolynk.com/pos_admin/api
# Public uploads/images use /pos_admin/uploads/... (ASSET_BASE_URL optional override)
# ASSET_BASE_URL=https://testv3.websitedemolynk.com/pos_admin
# Subdirectory deploy (Apache/cPanel proxy to Node on PORT)
# BASE_PATH=/pos_admin
# PORT=8000
# NODE_ENV=production

# live (Atlas) — set APP_ENV=live (or NODE_ENV=production)
MONGODB_URI_LIVE=mongodb+srv://<user>:<password>@cluster0.jok4qhf.mongodb.net/test?retryWrites=true&w=majority

# Redis — list cache (key: {companyId}:{module}:get-all-active|get-all[:q:hash])
# Local without Docker: install Redis in WSL2 — see scripts/WSL-REDIS.md
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
# Seconds (not ms). 259200 = 3 days. Used when REDIS_TTL_LIST_CACHE is unset.
REDIS_TTL_WAREHOUSE_ACTIVE=259200
REDIS_TTL_LIST_CACHE=1
REDIS_MEMORY_FALLBACK=true
# REDIS_ENABLED=false → cache lives only in this Node process; npm run dev restarts wipe it.

# Redis queues — tenant job queues (key: {companyId}:{module}:queue)
REDIS_QUEUE_ENABLED=true
REDIS_QUEUE_MEMORY_FALLBACK=true

# fetch_product: ?queue=1 on sync-store-product, or set true to always queue (skip inline sync)
FETCH_PRODUCT_AUTO_QUEUE=false

# Auto-run process queue: drain jobs batch-by-batch until finished
PROCESS_QUEUE_WORKER_ENABLED=true
PROCESS_QUEUE_WORKER_POLL_MS=10000
PROCESS_QUEUE_WORKER_BATCH_DELAY_MS=1000
PROCESS_QUEUE_WORKER_DEBOUNCE_MS=500
PROCESS_QUEUE_WORKER_MAX_BATCHES=5000

# Courier Integration Module
# true = all couriers use sandbox/test APIs (TCS, Leopard, PostEx, …)
# false = production courier APIs
COURIER_SANDBOX=true
# 32+ char secret used to AES-encrypt courier API credentials at rest
# COURIER_ENCRYPTION_KEY=change-me-to-a-long-random-string
COURIER_TRACKING_SYNC_ENABLED=true
COURIER_TRACKING_SYNC_MS=1800000
COURIER_TRACKING_SYNC_LIMIT=100
COURIER_HTTP_TIMEOUT_MS=30000
COURIER_HTTP_RETRIES=2
